# Lyra / Unreal Engine standard gitignore

# Built-in directories
Binaries/
Build/
DerivedDataCache/
Intermediate/
Saved/
Script/

# Autogenerated VS/Mac project files
.vs/
*.sln
*.vc.db
*.opendb
*.sdf
*.suo
*.xcodeproj
*.xcworkspace

# JetBrains Rider & CLion
.idea/
CMakeSettings.json

# Visual Studio Code
.vscode/

# Crash reports and log directories
*.log
*.crash
CrashReportClient/

# Built-in plugins or external dependencies built locally
Plugins/*/Binaries/
Plugins/*/Intermediate/

# User-specific configuration or local overrides
DefaultEditorPerProjectUserSettings.ini
DefaultEditorSettings.ini

# Package builds (if you build your game into the project folder)
Builds/
ArchivedBuilds/

# Mobile specific
/.import/
/android/

# Backup and Autosave files
*_Backup.*
*Content/Autosave/
*Content/Collections/

# External assets / Megascans downloaded locally to the project
Content/Megascans/

# OS-specific files
.DS_Store
Thumbs.db